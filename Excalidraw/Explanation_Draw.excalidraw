    },
    {
      "id": "utqqEMwnnNRzyvqXUiKUB",
      "type": "text",
      "x": 392.8411324685703,
      "y": -361.42746267717047,
      "width": 1240.306817075363,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bX1",
      "roundness": null,
      "seed": 1758776208,
      "version": 968,
      "versionNonce": 430440848,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789883988116,
      "created": 1789879333847,
      "link": null,
      "locked": false,
      "text": "This project uses the Global Superstore dataset, fictional sample data published by Tableau. It imitates a global retailer\nselling furniture, office supplies and technology products across 147 countries from 2011 to 2014. The data comes as a single\ntable of 51,290 rows and 24 columns, and it contains several real data-quality issues, including reused product and order IDs\nand customers recorded under two different ID formats.\n\nEach row represents one product on one order (an order line).\n    - A customer can place many orders.\n    - An order can contain many products.\n    - A product can appear in many orders.\n    - Order IDs are not unique to one customer: 659 order IDs are shared by different customers.\n\nPrimary key: row_id. No combination of customer, order and product IDs is unique.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This project uses the Global Superstore dataset, fictional sample data published by Tableau. It imitates a global retailer selling furniture, office supplies and technology products across 147 countries from 2011 to 2014. The data comes as a single table of 51,290 rows and 24 columns, and it contains several real data-quality issues, including reused product and order IDs and customers recorded under two different ID formats.\n\nEach row represents one product on one order (an order line).\n    - A customer can place many orders.\n    - An order can contain many products.\n    - A product can appear in many orders.\n    - Order IDs are not unique to one customer: 659 order IDs are shared by different customers.\n\nPrimary key: row_id. No combination of customer, order and product IDs is unique.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5xmVHWqxpSrpHIdWVB03W",
      "type": "text",
      "x": 446.3289887317509,
      "y": 68.08305883989868,
      "width": 795.4795532226562,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bX2",
      "roundness": null,
      "seed": 818582416,
      "version": 124,
      "versionNonce": 1476259728,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789879487906,
      "created": 1789879478307,
      "link": null,
      "locked": false,
      "text": "Rows        51,290 (one row per order line)\nColumns        24\nPeriod        1 January 2011 – 31 December 2014\nCountries        147, grouped into 13 regions and 7 markets\nOrders        25,035 order IDs\nCustomers        1,590 IDs, which are really 795 people (your Check 8)\nProducts        10,292 product IDs, which are really 10,768 products (your Check\n5)\nTotal sales        about 12.64 million\nTotal profit        about 1.47 million",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rows        51,290 (one row per order line)\nColumns        24\nPeriod        1 January 2011 – 31 December 2014\nCountries        147, grouped into 13 regions and 7 markets\nOrders        25,035 order IDs\nCustomers        1,590 IDs, which are really 795 people (your Check 8)\nProducts        10,292 product IDs, which are really 10,768 products (your Check 5)\nTotal sales        about 12.64 million\nTotal profit        about 1.47 million",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
